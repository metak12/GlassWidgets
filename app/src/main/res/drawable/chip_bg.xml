<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#30FFFFFF">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape>
                    <corners android:radius="12dp" />
                    <solid android:color="#59FF8A3D" />
                    <stroke android:width="1dp" android:color="@color/accent" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="12dp" />
                    <solid android:color="#14FFFFFF" />
                    <stroke android:width="1dp" android:color="@color/card_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
